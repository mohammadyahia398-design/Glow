<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shuffle_all"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_shuffle"
        android:shortcutLongLabel="@string/shortcut_shuffle_long"
        android:shortcutShortLabel="@string/shortcut_shuffle_short">
        <intent
            android:action="com.glow.app.action.SHUFFLE_ALL"
            android:targetClass="com.glow.app.MainActivity"
            android:targetPackage="com.glow.app" />
    </shortcut>
    <shortcut
        android:shortcutId="open_online"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_online"
        android:shortcutLongLabel="@string/shortcut_online_long"
        android:shortcutShortLabel="@string/shortcut_online_short">
        <intent
            android:action="com.glow.app.action.OPEN_ONLINE"
            android:targetClass="com.glow.app.MainActivity"
            android:targetPackage="com.glow.app" />
    </shortcut>
</shortcuts>
